---
// A twinkling night sky behind the hero. Positions, sizes and timings are random but seeded, so
// every build draws the same sky and the HTML stays stable. Each star runs its own CSS animation
// with a random duration and a negative delay, so they dim and brighten out of step from the first
// frame. No JavaScript runs.
interface Props {
  count?: number;
  seed?: number;
}
const { count = 110, seed = 7 } = Astro.props;

// mulberry32: a tiny seeded PRNG.
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const between = (min: number, max: number) => min + rand() * (max - min);
const round = (n: number, d = 2) => Number(n.toFixed(d));

const stars = Array.from({ length: count }, () => {
  // Most stars are pinpricks; a few are brighter and carry a glow.
  const bright = rand() < 0.12;
  return {
    x: round(between(0, 100)),
    y: round(between(0, 100)),
    size: round(bright ? between(2, 2.8) : between(1, 1.8)),
    lo: round(between(0.08, 0.35)),
    hi: round(bright ? between(0.8, 1) : between(0.45, 0.85)),
    duration: round(between(2.5, 8), 1),
    delay: round(-between(0, 8), 1),
    bright,
    warm: rand() < 0.35,
  };
});
---

<div class="stars" aria-hidden="true">
  {
    stars.map((s) => (
      <span
        class:list={['star', { bright: s.bright, warm: s.warm }]}
        style={`left:${s.x}%;top:${s.y}%;--size:${s.size}px;--lo:${s.lo};--hi:${s.hi};--dur:${s.duration}s;--delay:${s.delay}s`}
      />
    ))
  }
</div>

<style>
  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Moonlight washes out the stars near the moon, as it does in a real sky. */
    mask-image: radial-gradient(1100px circle at 100% 0%, transparent 18%, #000 55%);
  }
  .star {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: #f1f1ec;
    opacity: var(--lo);
    animation: twinkle var(--dur) ease-in-out var(--delay) infinite;
  }
  .warm {
    background: #f3e8c8;
  }
  .bright {
    box-shadow: 0 0 6px 1px rgb(241 241 236 / 45%);
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: var(--lo);
    }
    50% {
      opacity: var(--hi);
    }
  }
  /* Phones get a sparser sky. */
  @media (max-width: 720px) {
    .star:nth-child(2n) {
      display: none;
    }
    .stars {
      mask-image: radial-gradient(420px circle at 100% 12%, transparent 15%, #000 55%);
    }
  }
  /* Still stars for readers who turned motion off. */
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
      opacity: calc((var(--lo) + var(--hi)) / 2);
    }
  }
</style>
