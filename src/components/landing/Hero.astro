---
import HeroInstall from './HeroInstall.astro';
import Stars from './Stars.astro';
---

<header class="hero">
  <Stars />
  <div class="moon" aria-hidden="true">
    <span class="crater c1"></span><span class="crater c2"></span><span class="crater c3"></span>
  </div>
  <slot name="nav" />
  <div class="container body">
    <div class="copy">
      <p class="eyebrow">Rust + WebAssembly release engine</p>
      <h1><span class="sr-only">Moonlit: </span>Bring light to your release process.</h1>
      <p class="sub">
        Declare your pipeline in <strong>YAML</strong>. Sandboxed <strong>WebAssembly</strong> plugins tag,
        build, publish and announce it, from one native binary.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/guide/quick-start/">Get started</a>
        <HeroInstall />
      </div>
    </div>

    <div class="demo">
      <div class="bar">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        <span class="file">release.yml</span>
      </div>
      <pre class="snippet yaml"><span class="k">stages</span>:
  <span class="k">analyze</span>:
    - <span class="k">name</span>: version
      <span class="k">run</span>: <span class="f">sr.calculate-version</span>
      <span class="k">haltIf</span>: <span class="s">"!output.version.hasNewVersion"</span>
  <span class="k">release</span>:
    - <span class="k">name</span>: release
      <span class="k">run</span>: <span class="f">gh.create-release</span>
      <span class="k">config</span>:
        <span class="k">tag</span>: <span class="s">"v$(output:version:nextVersion)"</span></pre>
      <pre class="snippet"><span class="f">$</span> moonlit run
<span class="c">  analyze</span>
  <span class="ok">✓</span> repo           git.repo-context
  <span class="ok">✓</span> commits        git.commits
  <span class="ok">✓</span> version        sr.calculate-version   <span class="c">→ 2.4.0</span>
<span class="c">  release</span>
  <span class="ok">✓</span> changelog      sr.generate-changelog
  <span class="f">●</span> release        gh.create-release      <span class="c">running…</span></pre>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-bottom: 96px;
    border-bottom: 1px solid var(--edge-soft);
  }
  /* Moonlight: a faint wash from the top-right corner, where the moon sits. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(900px circle at 96% -4%, rgb(238 226 195 / 9%), transparent 62%);
    pointer-events: none;
  }
  /* The moon from the logo: a cream disc with its craters, half out of the top-right corner.
     Sizes and craters scale from --moon-size; the halo rings are what reads as its light. */
  .moon {
    --moon-size: 460px;
    position: absolute;
    top: calc(var(--moon-size) * -0.38);
    right: calc(var(--moon-size) * -0.3);
    width: var(--moon-size);
    height: var(--moon-size);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #f4ead0 0%, #eee2c3 55%, #e2d4ad 100%);
    box-shadow:
      0 0 0 calc(var(--moon-size) * 0.06) rgb(238 226 195 / 6%),
      0 0 0 calc(var(--moon-size) * 0.15) rgb(238 226 195 / 3.5%),
      0 0 0 calc(var(--moon-size) * 0.27) rgb(238 226 195 / 2%),
      0 0 calc(var(--moon-size) * 0.5) calc(var(--moon-size) * 0.12) rgb(238 226 195 / 14%);
  }
  .crater {
    position: absolute;
    border-radius: 50%;
    background: var(--crater);
  }
  .c1 {
    top: 54%;
    left: 20%;
    width: 22%;
    height: 19%;
  }
  .c2 {
    top: 60%;
    left: 55%;
    width: 6%;
    height: 6%;
  }
  .c3 {
    top: 78%;
    left: 34%;
    width: 7%;
    height: 6%;
  }
  @media (max-width: 1100px) {
    .moon {
      --moon-size: 320px;
    }
  }
  .body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding-top: 88px;
  }
  .copy {
    flex: 1 1 440px;
    min-width: 0;
  }
  h1 {
    margin: 0 0 20px;
    font: 700 56px/1.05 var(--font-display);
    letter-spacing: -0.5px;
  }
  .sub {
    margin: 0 0 32px;
    max-width: 480px;
    font-size: 19px;
    color: var(--mute);
  }
  .sub strong {
    font-weight: 600;
    color: var(--line);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px;
  }
  .demo {
    position: relative;
    flex: 1 1 520px;
    min-width: 0;
    border: 1px solid var(--edge);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
    box-shadow:
      0 30px 80px -30px rgb(0 0 0 / 70%),
      24px -24px 90px -40px rgb(238 226 195 / 28%);
  }
  /* Moonlight catching the window's edge: the border brightens toward the moon, top right. */
  .demo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 1.5px;
    border-radius: inherit;
    background: linear-gradient(
      220deg,
      rgb(246 238 216 / 100%) 0%,
      rgb(238 226 195 / 70%) 16%,
      rgb(238 226 195 / 30%) 38%,
      rgb(238 226 195 / 10%) 58%,
      transparent 78%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  /* And a little of it falling on the glass. */
  .demo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(520px circle at 100% 0%, rgb(238 226 195 / 9%), transparent 70%);
    pointer-events: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--edge-soft);
  }
  .bar > span:not(.file) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--edge-strong);
  }
  .file {
    margin-left: 8px;
    font: 500 12px var(--font-mono);
    color: var(--line);
  }
  .yaml {
    border-bottom: 1px solid var(--edge-soft);
  }
  @media (max-width: 720px) {
    .body {
      padding-top: 48px;
    }
    h1 {
      font-size: 42px;
    }
    /* Below the nav, so it never sits under the GitHub link, and dimmed behind the copy. */
    .moon {
      --moon-size: 128px;
      top: 92px;
      right: -56px;
      opacity: 0.45;
    }    .crater {
      display: none;
    }
  }
</style>
